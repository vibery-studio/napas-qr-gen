{
  "$schema": "https://unpkg.com/wrangler@4.57.0/config-schema.json",
  "name": "napas-qr-gen",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "rules": [{ "type": "Text", "globs": ["**/jsQR.js"], "fallthrough": true }],
  "routes": [{ "pattern": "bankqr.vibery.app", "custom_domain": true }]
}
